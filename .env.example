# SpacedBro configuration — copy to `.env` and fill in real values.
# The `.env` file is gitignored and must never be committed.

# Telegram bot token from @BotFather
BOT_TOKEN=

# OpenAI API key (used for extraction, image vision, and `back` generation)
OPENAI_API_KEY=

# SQLite database URL. Docker Compose already sets this to the /data volume;
# override only for a local run (e.g. sqlite:////tmp/spacedbro.db).
# DATABASE_URL=sqlite:////data/spacedbro.db

# Optional: health server binding
# HEALTH_HOST=0.0.0.0
# HEALTH_PORT=8080

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO
