# SpacedBro configuration — copy to `.env` and fill in real values.
# The `.env` file is gitignored and must never be committed.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Deployment environment — REQUIRED, exactly one of: development | preprod | production
# Any other value (or an empty value) aborts startup with exit code 78 (EX_CONFIG).
APP_ENV=development

# --- LLM backend (all optional; composed per variable over the APP_ENV defaults) ---
# Pinned defaults:
#   development -> openai_compatible, http://localhost:11434/v1, gemma-4-e2b-it (local-dev sentinel key)
#   preprod / production -> openai, https://api.openai.com/v1, gpt-5.6-luna (OPENAI_API_KEY required)
# OPENAI_API_KEY is only consulted when the resolved provider is `openai`.
OPENAI_API_KEY=
# LLM_PROVIDER=openai|openai_compatible
# LLM_MODEL=gemma-4-e2b-it
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2

# SQLite database URL. Docker Compose already sets this to the /data volume;
# override only for a local run (e.g. sqlite:////tmp/spacedbro.db).
# DATABASE_URL=sqlite:////data/spacedbro.db

# Optional: health server binding
# HEALTH_HOST=0.0.0.0
# HEALTH_PORT=8080

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO

# --- Proactive scheduler (BON-33, design §8) — both optional ---
# Pass interval in minutes (default: 5).
# SCHEDULER_INTERVAL_MINUTES=5
# Dry-run: the proactive pass runs and logs, but nothing is sent or
# counted (the smoke checklist's "proactive dry-run"). 1/true/yes/on.
# SCHEDULER_DRY_RUN=
